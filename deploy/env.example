# VM의 /opt/alkkagi/.env로 복사해 값을 채운다(chmod 600). 저장소에는 값을 올리지 않는다.
# 서비스 도메인(예: game.example.com). Cloudflare 프록시(주황 구름)를 켠 DNS 레코드여야 한다.
ALKKAGI_DOMAIN=
# DB 비밀번호. URL에 그대로 들어가므로 openssl rand -hex 24로 만든다.
POSTGRES_PASSWORD=
# 세션 서명 비밀. openssl rand -base64 48
SESSION_SECRET=
# 비밀값 교체 중에만 이전 SESSION_SECRET을 둔다(OPERATIONS 세션 비밀값 교체). 평소에는 비운다
SESSION_SECRET_PREVIOUS=
# --- DB 백업(OPS-005, OPERATIONS 백업·복구) ---
# Cloudflare R2 S3 주소(https://<계정 ID>.r2.cloudflarestorage.com)와 버킷 이름
R2_ENDPOINT=
R2_BUCKET=
# 이 버킷에만 읽기·쓰기 권한을 준 R2 API 토큰의 S3 키
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# 백업 암호화 암호. openssl rand -base64 48. 잃으면 복구할 수 없으니 VM 밖(비밀번호 관리자)에도 둔다
BACKUP_CIPHER_PASS=
# 백업·보관 실패 알림을 보낼 Discord 웹후크 주소
DISCORD_WEBHOOK_URL=
